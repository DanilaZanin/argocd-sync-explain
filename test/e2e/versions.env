# Pinned inputs of the e2e environment. Change them only together with the
# "Supported Argo CD versions" section of the README.
#
# Kubernetes: Argo CD tested-versions table (docs/operator-manual/tested-kubernetes-versions.md)
# lists v1.35 for both Argo CD 3.5 and 3.4. Node image from the kind v0.33.0 release notes.
KIND_NODE_IMAGE=kindest/node:v1.35.8@sha256:07b2536e30b803ed61d1677a79df6115f798ce64c80f9e22f6ed45afd09323c0

# Current and previous minor Argo CD releases (install.yaml fetched by tag, verified by sha256).
ARGO_CURRENT=v3.5.3
ARGO_PREVIOUS=v3.4.9
ARGO_SHA256_v3_5_3=7efe2d6bbc03f63623640f1e4198f16c84009d510fb810ef71e56df1b7614ba9
ARGO_SHA256_v3_4_9=e07988f5fdede685bbad71703bdab724ba4baf9d49bb640925fc9898ba2ad750

# Images used inside the cluster (pulled on the host and loaded with `kind load`, which avoids
# registry rate limits during test runs).
ARGOCD_IMAGE_v3_5_3=quay.io/argoproj/argocd:v3.5.3
ARGOCD_IMAGE_v3_4_9=quay.io/argoproj/argocd:v3.4.9
REDIS_IMAGE=public.ecr.aws/docker/library/redis:8.2.3-alpine
GITEA_IMAGE=gitea/gitea:1.24
BUSYBOX_IMAGE=busybox:1.37
